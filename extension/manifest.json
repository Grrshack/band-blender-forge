{
  "manifest_version": 3,
  "name": "Band Blender: Send to Suno",
  "short_name": "Band Blender",
  "version": "1.0.0",
  "description": "Sends your Band Blender title, style, exclude list and lyrics into Suno's Create page. It fills the boxes; you press Create.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://suno-blender.lovable.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://suno.com/*"
      ],
      "js": [
        "suno.js"
      ],
      "run_at": "document_idle"
    }
  ]
}