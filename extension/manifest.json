{
  "manifest_version": 3,
  "name": "Band Blender: Send to Suno",
  "short_name": "Band Blender",
  "version": "1.1.0",
  "description": "Sends your Band Blender song into Suno (or Gemini, ElevenLabs) and checks Suno's boxes as you type. You press Create.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://suno-blender.lovable.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://suno.com/*"
      ],
      "js": [
        "live.js",
        "suno.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://elevenlabs.io/*"
      ],
      "js": [
        "engines.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}